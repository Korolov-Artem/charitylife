# Origin the API is served from. Vite inlines this at build time, so it must be
# set before `vite build`, not on the server afterwards.
#
# Local:      http://localhost:3000
# Production: put your real origin in .env.production, e.g.
#             VITE_API_URL=https://api.yourdomain.com.ua
VITE_API_URL=http://localhost:3000
